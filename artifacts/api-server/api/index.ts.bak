  const showAll = req.query.all === "true" && isAdminRequest(req);
  const rows = await db
    .select()
    .from(blogsTable)
    .where(showAll ? undefined : eq(blogsTable.published, true))
    .orderBy(desc(blogsTable.createdAt));
  res.json(rows);
});


app.put("/api/blogs/:id", requireAdmin, async (req, res) => {
  const id = Number(req.params.id);
  const data = req.body;
  const updateFields: Record<string, unknown> = {};
  for (const key of ["title", "summary", "content", "imageUrl", "author", "tags", "published"]) {
    if (data[key] !== undefined) updateFields[key] = data[key];
  }
  const [blog] = await db.update(blogsTable).set(updateFields).where(eq(blogsTable.id, id)).returning();
  if (!blog) {
    res.status(404).json({ error: "Blog post not found" });

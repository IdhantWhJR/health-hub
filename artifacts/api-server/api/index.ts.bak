app.delete("/api/blogs/:id", requireAdmin, async (req, res) => {
  const id = Number(req.params.id);
  await db.delete(blogsTable).where(eq(blogsTable.id, id));
  res.sendStatus(204);
});

// ---------- timeslots ----------
app.get("/api/timeslots", async (_req, res) => {
  const today = new Date().toISOString().split("T")[0];
  const rows = await db
    .select()
    .from(timeslotsTable)
    .where(eq(timeslotsTable.isBooked, false))
    .orderBy(asc(timeslotsTable.date), asc(timeslotsTable.startTime));
  res.json(rows.filter((r) => r.date >= today));
});

app.post("/api/timeslots", requireAdmin, async (req, res) => {
  const data = req.body;
  const [slot] = await db
    .insert(timeslotsTable)
    .values({
      date: String(data.date),
      startTime: data.startTime,
      endTime: data.endTime,
      label: data.label ?? null,
      isBooked: false,
    })
    .returning();
  res.status(201).json(slot);
});

app.get("/api/timeslots/all", requireAdmin, async (_req, res) => {
  const rows = await db.select().from(timeslotsTable).orderBy(asc(timeslotsTable.date), asc(timeslotsTable.startTime));
  res.json(rows);
});

app.patch("/api/timeslots/:id", requireAdmin, async (req, res) => {
  const id = Number(req.params.id);
  const data = req.body;
  const updateFields: Record<string, unknown> = {};
  if (data.date !== undefined) updateFields.date = String(data.date);
  if (data.startTime !== undefined) updateFields.startTime = data.startTime;
  if (data.endTime !== undefined) updateFields.endTime = data.endTime;
  if (data.label !== undefined) updateFields.label = data.label;
  if (data.isBooked !== undefined) updateFields.isBooked = data.isBooked;
  const [slot] = await db.update(timeslotsTable).set(updateFields).where(eq(timeslotsTable.id, id)).returning();
  if (!slot) {
    res.status(404).json({ error: "Time slot not found" });
    return;
  }
  res.json(slot);
});

app.delete("/api/timeslots/:id", requireAdmin, async (req, res) => {
  const id = Number(req.params.id);
  const [slot] = await db.select().from(timeslotsTable).where(eq(timeslotsTable.id, id));
  if (!slot) {
    res.status(404).json({ error: "Time slot not found" });
    return;
  }
  if (slot.isBooked) {
    res.status(400).json({ error: "Cannot delete a booked time slot." });
    return;
  }
  await db.delete(timeslotsTable).where(eq(timeslotsTable.id, id));
  res.sendStatus(204);
});

// ---------- bookings ----------
app.get("/api/bookings", requireAdmin, async (_req, res) => {
  const rows = await db.select().from(bookingsTable).orderBy(desc(bookingsTable.createdAt));
  res.json(rows);
});

app.post("/api/bookings", async (req, res) => {
  const data = req.body;
  let slotDate: string | null = null;
  let slotStartTime: string | null = null;
  let slotEndTime: string | null = null;

  if (data.bookingType === "slot") {
    if (!data.timeslotId) {
      res.status(400).json({ error: "timeslotId is required for slot bookings." });
      return;
    }
    const [slot] = await db.select().from(timeslotsTable).where(eq(timeslotsTable.id, data.timeslotId));
    if (!slot) {
      res.status(404).json({ error: "Time slot not found." });
      return;
    }
    if (slot.isBooked) {
      res.status(400).json({ error: "This time slot has already been booked." });
      return;
    }
    await db.update(timeslotsTable).set({ isBooked: true }).where(eq(timeslotsTable.id, data.timeslotId));
    slotDate = slot.date;
    slotStartTime = slot.startTime;
    slotEndTime = slot.endTime;
  }

  const [booking] = await db
    .insert(bookingsTable)
    .values({
      timeslotId: data.timeslotId ?? null,
      name: data.name,
      email: data.email,
      phone: data.phone ?? null,
      message: data.message ?? null,
      bookingType: data.bookingType,
    })
    .returning();

  // NOTE: email notification is temporarily disabled — src/lib/email.ts
  // isn't reachable from this inlined entrypoint yet. Add back once
  // src/ bundling is fixed properly.

  res.status(201).json(booking);
});

app.delete("/api/bookings/:id", requireAdmin, async (req, res) => {
  const id = Number(req.params.id);
  const [booking] = await db.select().from(bookingsTable).where(eq(bookingsTable.id, id));
  if (!booking) {
    res.status(404).json({ error: "Booking not found" });
    return;
  }
  if (booking.timeslotId) {
    await db.update(timeslotsTable).set({ isBooked: false }).where(eq(timeslotsTable.id, booking.timeslotId));
  }
  await db.delete(bookingsTable).where(eq(bookingsTable.id, id));
  res.sendStatus(204);
});
app.use((err: any, _req: Request, res: Response, _next: NextFunction) => {
  console.error("UNHANDLED ERROR:", err);
  console.error("CAUSE:", err?.cause);
  res.status(500).json({
    error: err?.message || "Internal server error",
    cause: err?.cause?.message || err?.cause || null,
  });
});

export default app;